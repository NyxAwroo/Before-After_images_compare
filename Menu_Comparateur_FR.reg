Windows Registry Editor Version 5.00

; 1. SUPPRESSION DES ANCIENS MENUS
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\Comparateur]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\Comparateur]
[-HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro]
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro]

; 2. INSTALLATION DU NOUVEAU MENU PRO POUR LES IMAGES
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro]
"MUIVerb"="Comparateur Pro"
"Icon"="imageres.dll,-68"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro\shell\cmd1]
"MUIVerb"="1. Ouvrir dans Comparateur Pro"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro\shell\cmd1\command]
@="pyw \"D:\\Documents\\Python Scripts\\comparaison image AVANT-APRES\\Before-After_images_compare\\comparateur_app.py\" \"%1\""

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro\shell\cmd2]
"MUIVerb"="2. Generer Export Rapide"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\image\shell\ComparateurPro\shell\cmd2\command]
@="pyw \"D:\\Documents\\Python Scripts\\comparaison image AVANT-APRES\\Before-After_images_compare\\comparateur_app.py\" \"%1\" --export-rapide"

; 3. INSTALLATION DU NOUVEAU MENU PRO POUR LES DOSSIERS
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro]
"MUIVerb"="Comparateur Pro"
"Icon"="imageres.dll,-68"
"SubCommands"=""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro\shell\cmd1]
"MUIVerb"="1. Ouvrir le dossier dans Comparateur Pro"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro\shell\cmd1\command]
@="pyw \"D:\\Documents\\Python Scripts\\comparaison image AVANT-APRES\\Before-After_images_compare\\comparateur_app.py\" \"%V\""

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro\shell\cmd2]
"MUIVerb"="2. Export Batch (Tout le dossier)"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\ComparateurPro\shell\cmd2\command]
@="pyw \"D:\\Documents\\Python Scripts\\comparaison image AVANT-APRES\\Before-After_images_compare\\comparateur_app.py\" \"%V\" --batch"